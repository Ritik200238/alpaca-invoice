// v3 参数清单（Leo 3.4 不会自动读取此文件，仅作参考）
// 使用方式：按 [transition名] 区块把参数按顺序复制到命令行，例如：
//   leo run compute_invoice_hash <seller> <buyer> 1000000u64 100000u64 ...
// 详见 tests/inputs/v3/README.md
// seller 请替换为 leo run get_caller 输出；invoice_hash / jct 等需按推荐顺序先跑前序 transition 后填入

[compute_invoice_id]
seller: address = aleo158ppqgwwvz4z8gcxg6la3j83t3zvw6uud09ck3vvp29c7ggh0qgqj93d4t;
buyer: address = aleo1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq3ljyzc;
amount: u64 = 1000000u64;
due_date: u32 = 1735689600u32;
nonce: field = 99999field;

[compute_invoice_hash]
seller: address = aleo158ppqgwwvz4z8gcxg6la3j83t3zvw6uud09ck3vvp29c7ggh0qgqj93d4t;
buyer: address = aleo1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq3ljyzc;
