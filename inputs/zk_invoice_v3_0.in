[create_invoice]
buyer: address = aleo1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq3ljyzc;
amount: u64 = 1000000u64;
tax_amount: u64 = 100000u64;
due_date: u32 = 1735689600u32;
invoice_hash: field = 0field;
nonce: field = 99999field;
current_time: u32 = 1700000000u32;
order_id: field = 0field;
currency: field = 840field;
items_hash: field = 11111field;
memo_hash: field = 0field;
line_items_sum: u64 = 1000000u64;
expected_total: u64 = 1100000u64;
tax_rate_bps: u64 = 1000u64;
jct: CreateInvoiceJct = CreateInvoiceJct {
    tax_groups: TaxGroups {
        group_a: TaxGroup { rate_bps: 0u64, net_sum: 0u64, tax_sum: 0u64 },
        group_b: TaxGroup { rate_bps: 0u64, net_sum: 0u64, tax_sum: 0u64 }
    },
    tax_tag: 0field,
    total_amount: 1100000u64,
    jct_registration: 0field,
    currency_flag: 0u8
};

[get_invoice_tax_tag]
invoice_id: field = 0field;

[get_invoice_jct_reg]
invoice_id: field = 0field;

[get_invoice_tx_id]
