[make_jct_jct]
ga_rate_bps: u64 = 1000u64;
ga_net_sum: u64 = 1000000u64;
ga_tax_sum: u64 = 100000u64;
gb_rate_bps: u64 = 800u64;
gb_net_sum: u64 = 0u64;
