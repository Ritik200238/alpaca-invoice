# ============================================================
# zk_credit_v1.aleo 部署配置（复制为 .env，填入私钥后运行）
# ============================================================

# 你的 Aleo 账户私钥（APrivateKey1zkp... 开头）
PRIVATE_KEY=

# 目标网络（testnet / mainnet）
NETWORK=testnet

# 优先费用（microcredits，0 = 不加速）
PRIORITY_FEE=0
